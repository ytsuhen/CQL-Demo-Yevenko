    "build": "node web/build.mjs",
    "start": "node web/build.mjs && node web/serve.mjs"
  },
  "dependencies": {
    "@cqframework/cql": "5.4.0",
    "@lhncbc/ucum-lhc": "7.1.9",
    "cql-exec-fhir": "2.2.0",
    "cql-execution": "3.3.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "events": "3.3.0"
  }
}
