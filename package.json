{
  "name": "cql-demo-yevenko",
  "version": "0.1.0",
  "private": true,
  "description": "Clinical decision rules in CQL over FHIR R4: compiler, engine, test scenarios and a patient chat that shows the engine's input and output",
  "author": "Andrii Yevenko <yevenko.a.p@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
